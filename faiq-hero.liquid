<div class="faiq-custom-hero">
  {% if section.settings.background_image != blank %}
    <img src="{{ section.settings.background_image | image_url: width: 1500 }}" style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; z-index:1;">
  {% endif %}
  <div class="hero-wrapper">
    <h1>{{ section.settings.heading | upcase }}</h1>
    <p>{{ section.settings.subheading }}</p>
    {% if section.settings.button_link != blank and section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="hero-btn">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

<style>
  .faiq-custom-hero {

    color: #ffffff;
    padding: 80px 20px;
    text-align: center;
    border-radius: 8px;
    margin: 40px auto;
    max-width: 1200px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .hero-wrapper h1 {
    font-size: 3rem;
    color: #00d2ff;
    margin-bottom: 20px;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .hero-wrapper p {
    font-size: 1.25rem;
    color: #b4c6d0;
    margin-bottom: 35px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .hero-btn {
    background-color: #00d2ff;
    color: #111e2e;
    padding: 14px 35px;
    text-decoration: none;
    font-weight: bold;
    border-radius: 6px;
    font-size: 1rem;
    transition: all 0.3s ease;
    display: inline-block;
  }
  .hero-btn:hover {
    background-color: #ffffff;
    box-shadow: 0 0 20px rgba(0, 210, 255, 0.6);
    transform: translateY(-2px);
  }
</style>

{% schema %}
{
  "name": "Faiq Premium Hero",
  "tag": "section",
  "class": "section",
  "settings": [
   {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111e2e"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    }, 
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Title",
      "default": "Premium Shopify Experience"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "Delivering high-end, bespoke e-commerce solutions for global brands."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Faiq Premium Hero"
    }
  ]
}
{% endschema %}