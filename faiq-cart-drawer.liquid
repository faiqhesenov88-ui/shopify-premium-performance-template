<div id="FaiqCartDrawer" class="faiq-cart-drawer">
  <div class="faiq-drawer-overlay" onclick="closeCartDrawer()"></div>
  <div class="faiq-drawer-content">
    
    <div class="faiq-drawer-header">
      <h2>Your Cart</h2>
      <button class="faiq-drawer-close" onclick="closeCartDrawer()">&times;</button>
    </div>

    <div id="FaiqDrawerItems" class="faiq-drawer-items"></div>

    <div class="faiq-drawer-footer">
      <div class="faiq-drawer-total">
        <span>Total:</span>
        <span id="FaiqDrawerTotalPrice">0.00 AZN</span>
      </div>
      <a href="/checkout" class="faiq-drawer-checkout-btn">Proceed to Checkout</a>
    </div>

  </div>
</div>